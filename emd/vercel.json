{
  "functions": {
    "api/chat.ts": {
      "maxDuration": 30,
      "includeFiles": "api/lib/**"
    }
  },
  "env": {
    "GEMINI_API_KEY1": "@gemini_api_key1",
    "GEMINI_API_KEY2": "@gemini_api_key2",
    "GEMINI_API_KEY3": "@gemini_api_key3"
  },
  "rewrites": [
    {
      "source": "/((?!api/|src/|@|node_modules/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
  

}